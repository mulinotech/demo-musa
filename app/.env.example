# Configurações do Banco de Dados MySQL na Cloudez / Produção
DB_HOST="localhost"
DB_PORT=3306
DB_USER="seu_usuario_aqui"
DB_PASSWORD="sua_senha_aqui"
DB_NAME="demo_musaDB"

# Porta onde o servidor Node.js/Express vai escutar
PORT=3001

# Senhas de acesso ao Painel CRM (Admin)
VITE_ADMIN_PASSWORD="sua_senha_admin_aqui"
ADMIN_PASSWORD_2="sua_senha_admin_secundaria_aqui"

# Chave API do Google Gemini (IA)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Integração com Evolution API (WhatsApp)
EVOLUTION_API_URL="http://127.0.0.1:8090"
EVOLUTION_API_KEY="sua_chave_evolution_aqui"
VITE_EVOLUTION_MANAGER_URL="https://sua-url-evolution-manager.com"
# Opcional: fixa a instância usada nos envios. Se vazio, o sistema detecta
# automaticamente a primeira instância conectada da Evolution API.
EVOLUTION_INSTANCE_NAME=""
